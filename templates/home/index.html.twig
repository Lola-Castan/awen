{% extends 'base.html.twig' %}

{% block title %}Accueil - Awen{% endblock %}

{% block body %}
<div class="min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- En-tête de la page -->
        {# <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Bienvenue sur Awen</h1>
            <p class="text-lg text-gray-600">Découvrez l'artisanat local et connectez-vous avec les créateurs</p>
        </div> #}

        <!-- Boutons d'action rapide pour les utilisateurs connectés -->
        {% if app.user %}
        <div class="flex flex-wrap gap-4 justify-center mb-8">
            <a href="{{ path('app_post_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Nouveau post
            </a>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-600 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Administration
            </a>
            {% endif %}
        </div>
        {% endif %}

        <!-- Section principale avec onglets -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden" x-data="{ activeTab: 'posts' }">            <!-- Navigation des onglets -->
            <div class="border-b border-gray-200 bg-gray-50">
                <nav class="flex" aria-label="Tabs">
                    <button
                        @click="activeTab = 'posts'"
                        :class="activeTab === 'posts' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
                        class="w-1/2 py-4 px-1 text-center border-2 rounded-t-lg font-medium text-sm transition-all duration-200"
                    >
                        <div class="flex items-center justify-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                            </svg>
                            <span>Posts</span>
                            <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded-full">{{ latestPosts|length }}</span>
                        </div>
                    </button>                    <button
                        @click="activeTab = 'events'"
                        :class="activeTab === 'events' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
                        class="w-1/2 py-4 px-1 text-center border-2 rounded-t-lg font-medium text-sm transition-all duration-200"
                    >
                        <div class="flex items-center justify-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span>Événements</span>
                            <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded-full">{{ upcomingEvents|length }}</span>
                        </div>
                    </button>
                </nav>
            </div>

            <!-- Contenu des onglets -->
            <div class="p-6">
                <!-- Onglet Posts -->
                <div x-show="activeTab === 'posts'" x-transition:enter="transition ease-out duration-100" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-semibold text-gray-900">Derniers posts</h2>
                        <a href="{{ path('app_post_index') }}" class="text-sm text-primary hover:text-primary/80 font-medium">
                            Voir tous les posts →
                        </a>
                    </div>

                    {% if latestPosts|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for post in latestPosts %}
                        <article class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200">
                            {% if post.mainImage %}
                            <div class="aspect-w-16 aspect-h-9 overflow-hidden rounded-t-lg">
                                <img src="{{ asset('uploads/images/' ~ post.mainImage.filename) }}" 
                                     alt="{{ post.mainImage.alt }}" 
                                     class="w-full h-48 object-cover">
                            </div>
                            {% endif %}
                            
                            <div class="p-4">                                <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
                                    {% if post.author.profilePicture %}
                                        <img src="{{ asset('uploads/profile_pictures/' ~ post.author.profilePicture) }}" 
                                             alt="{{ post.author.firstName }}" 
                                             class="w-6 h-6 rounded-full object-cover">
                                    {% else %}
                                        <div class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs font-medium">
                                            {{ post.author.firstName|first|upper }}
                                        </div>
                                    {% endif %}
                                    <span>{{ post.author.firstName }} {{ post.author.lastName }}</span>
                                    <span>•</span>
                                    <time datetime="{{ post.createdAt|date('Y-m-d') }}">
                                        {{ post.createdAt|date('d/m/Y') }}
                                    </time>
                                </div>
                                
                                <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">
                                    <a href="{{ path('app_post_show', {'id': post.id}) }}" class="hover:text-primary">
                                        {{ post.title }}
                                    </a>
                                </h3>
                                
                                <p class="text-gray-600 text-sm line-clamp-3">
                                    {{ post.content|slice(0, 150) }}...
                                </p>
                                
                                <div class="mt-3">
                                    <a href="{{ path('app_post_show', {'id': post.id}) }}" 
                                       class="text-primary hover:text-primary/80 text-sm font-medium">
                                        Lire la suite →
                                    </a>
                                </div>
                            </div>
                        </article>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun post</h3>
                        <p class="mt-1 text-sm text-gray-500">Commencez par créer votre premier post.</p>
                        {% if app.user %}
                        <div class="mt-6">
                            <a href="{{ path('app_post_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary hover:bg-primary/90">
                                <svg class="-ml-1 mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
                                </svg>
                                Nouveau post
                            </a>
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>

                <!-- Onglet Événements -->
                <div x-show="activeTab === 'events'" x-transition:enter="transition ease-out duration-100" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-semibold text-gray-900">Événements à venir</h2>
                        <a href="{{ path('app_event_index') }}" class="text-sm text-primary hover:text-primary/80 font-medium">
                            Voir tous les événements →
                        </a>
                    </div>

                    {% if upcomingEvents|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for event in upcomingEvents %}
                        <article class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200">
                            {% if event.images.first %}
                            <div class="aspect-w-16 aspect-h-9 overflow-hidden rounded-t-lg">
                                <img src="{{ asset('uploads/images/' ~ event.images.first.filename) }}" 
                                     alt="{{ event.images.first.alt }}" 
                                     class="w-full h-48 object-cover">
                            </div>
                            {% else %}
                            <div class="h-48 bg-gray-200 rounded-t-lg flex items-center justify-center">
                                <span class="text-gray-400 text-sm">Photo lieu</span>
                            </div>
                            {% endif %}
                            
                            <div class="p-4">
                                <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <time datetime="{{ event.startDateTime|date('Y-m-d') }}">
                                        {{ event.startDateTime|date('d/m/Y') }}
                                    </time>
                                    <span>•</span>
                                    <span>{{ event.startDateTime|date('H:i') }}</span>
                                </div>
                                
                                <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">
                                    <a href="{{ path('app_event_show', {'id': event.id}) }}" class="hover:text-primary">
                                        {{ event.title }}
                                    </a>
                                </h3>
                                
                                <p class="text-gray-600 text-sm line-clamp-2 mb-2">
                                    {{ event.shortDescription }}
                                </p>
                                
                                {% if event.location %}
                                <div class="flex items-center text-sm text-gray-500 mb-3">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                    <span class="truncate">{{ event.location }}</span>
                                </div>
                                {% endif %}
                                
                                <div class="mt-3">
                                    <a href="{{ path('app_event_show', {'id': event.id}) }}" 
                                       class="text-primary hover:text-primary/80 text-sm font-medium">
                                        En savoir plus →
                                    </a>
                                </div>
                            </div>
                        </article>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun événement à venir</h3>
                        <p class="mt-1 text-sm text-gray-500">Les prochains événements seront affichés ici.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Classes utilitaires pour le line-clamp */
.line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
}
</style>
{% endblock %}
