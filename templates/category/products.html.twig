{% extends 'base.html.twig' %}

{% block title %}Produits de la catégorie {{ category.name }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            Produits de la catégorie "{{ category.name }}"
        </h1>
    </div>

    {% if products|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for product in products %}
                <a href="{{ path('app_product_show', {'id': product.id}) }}" class="group">
                    <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                        {% if product.mainImage %}
                            <div class="aspect-w-16 aspect-h-9">
                                <img src="{{ asset('uploads/images/' ~ product.mainImage.filename) }}" 
                                     alt="{{ product.name }}" 
                                     class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300">
                            </div>
                        {% endif %}
                        <div class="p-4">
                            <h2 class="text-lg font-medium text-gray-900 group-hover:text-primary truncate">{{ product.name }}</h2>
                            <p class="mt-1 text-sm text-gray-500 line-clamp-2">{{ product.shortDescription }}</p>
                            {% if product.categories|length > 0 %}
                                <div class="mt-2 flex flex-wrap gap-2">
                                    {% for cat in product.categories %}
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {% if cat.id == category.id %}bg-primary text-white{% else %}bg-gray-100 text-gray-700{% endif %}">
                                            {{ cat.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun produit</h3>
            <p class="mt-1 text-sm text-gray-500">Il n'y a pas encore de produits dans cette catégorie.</p>
        </div>
    {% endif %}
</div>
{% endblock %} 