{% extends 'base.html.twig' %}

{% block title %}Mon panier - Awen{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Mon panier</h1>

        {% if cart|length > 0 %}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                {# Liste des produits #}
                <div class="lg:col-span-2">
                    <div class="bg-white shadow rounded-lg overflow-hidden">
                        <div class="divide-y divide-gray-200">
                            {% for item in cart %}
                                <div class="p-6 flex items-center">
                                    {# Image du produit #}
                                    <div class="flex-shrink-0 w-24 h-24">
                                        {% if item.product.mainImage %}
                                            <img src="{{ asset('uploads/images/' ~ item.product.mainImage.filename) }}" 
                                                 alt="{{ item.product.name }}"
                                                 class="w-full h-full object-cover rounded-lg">
                                        {% else %}
                                            <div class="w-full h-full bg-gray-200 rounded-lg flex items-center justify-center">
                                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                        {% endif %}
                                    </div>

                                    {# Informations du produit #}
                                    <div class="ml-6 flex-1">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <h3 class="text-lg font-medium text-gray-900">
                                                    <a href="{{ path('app_product_show', {'id': item.product.id}) }}" class="hover:text-primary">
                                                        {{ item.product.name }}
                                                    </a>
                                                </h3>
                                                <p class="mt-1 text-sm text-gray-500">
                                                    Par 
                                                    {% if item.product.creator.creatorInfo is defined and item.product.creator.creatorInfo is not null and item.product.creator.creatorInfo.isActive() %}
                                                        <a href="{{ path('app_creator_show', {'id': item.product.creator.id}) }}" class="text-primary hover:underline">
                                                            {{ item.product.creator.creatorInfo.displayName }}
                                                        </a>
                                                    {% else %}
                                                        {{ item.product.creator.username }}
                                                    {% endif %}
                                                </p>
                                            </div>
                                            <p class="text-lg font-medium text-gray-900">
                                                {{ ((item.product.price / 100) * item.quantity)|number_format(2, ',', ' ') }} €
                                            </p>
                                        </div>

                                        {# Quantité #}
                                        <div class="mt-4 flex items-center justify-between">
                                            <div class="flex items-center">
                                                <form action="{{ path('app_cart_update', {'id': item.product.id}) }}" method="post" class="flex items-center">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('update' ~ item.product.id) }}">
                                                    <label for="quantity-{{ item.product.id }}" class="sr-only">Quantité</label>
                                                    <select name="quantity" 
                                                            id="quantity-{{ item.product.id }}"
                                                            onchange="this.form.submit()"
                                                            class="rounded-md border-gray-300 text-sm focus:border-primary focus:ring-primary">
                                                        {% for i in 1..10 %}
                                                            <option value="{{ i }}" {% if i == item.quantity %}selected{% endif %}>{{ i }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </form>
                                            </div>

                                            {# Bouton supprimer #}
                                            <form action="{{ path('app_cart_remove', {'id': item.product.id}) }}" method="post" class="ml-4">
                                                <input type="hidden" name="_token" value="{{ csrf_token('remove' ~ item.product.id) }}">
                                                <button type="submit" class="text-sm text-red-600 hover:text-red-800">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# Résumé de la commande #}
                <div class="lg:col-span-1">
                    <div class="bg-white shadow rounded-lg p-6">
                        <h2 class="text-lg font-medium text-gray-900 mb-4">Résumé de la commande</h2>
                        
                        <div class="space-y-4">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Sous-total</span>
                                <span class="text-gray-900">{{ (total / 100)|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Frais de livraison</span>
                                <span class="text-gray-900">Calculés à l'étape suivante</span>
                            </div>
                            <div class="border-t border-gray-200 pt-4">
                                <div class="flex justify-between">
                                    <span class="text-lg font-medium text-gray-900">Total</span>
                                    <span class="text-lg font-medium text-gray-900">{{ (total / 100)|number_format(2, ',', ' ') }} €</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6">
                            <a href="#" 
                               class="w-full bg-primary text-white px-4 py-2 rounded-md hover:bg-primary/90 text-center block">
                                Passer la commande
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">Votre panier est vide</h3>
                <p class="mt-1 text-sm text-gray-500">Commencez à ajouter des produits à votre panier.</p>
                <div class="mt-6">
                    <a href="{{ path('app_product_index') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90">
                        Découvrir nos produits
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %} 