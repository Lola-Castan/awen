<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('uploads/images/favicon.svg') }}" type="image/svg+xml">
        <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Open+Sans&display=swap" rel="stylesheet">
        {% block stylesheets %}
            <!-- CDN essentiels -->
            <script src="https://cdn.tailwindcss.com"></script>
            <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
            <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
            <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/fr.js"></script>
            
            <!-- CSS pour masquer le bouton de suppression des champs search -->
            <link rel="stylesheet" href="{{ asset('css/search.css') }}">
            <!-- Configuration de base pour Tailwind -->
            <script>
                tailwind.config = {
                    theme: {
                        extend: {
                            colors: {
                                primary: '#EC671B',
                                secondary: '#10B981'
                            },
                            fontFamily: {
                                'nunito': ['Nunito', 'sans-serif'],
                                'opensans': ['Open Sans', 'sans-serif'],
                            },
                            fontSize: {
                                'h1': '32px',
                                'h2': '28px',
                                'h3': '24px',
                                'h4': '20px',
                                'body': '12px',
                                'cta': '20px',
                            }
                        }
                    }
                };
            </script>

            <!-- Styles de base -->
            <style type="text/tailwindcss">
                @layer base {
                    h1 {
                        @apply font-nunito font-bold;
                    }
                    h2 {
                        @apply font-nunito font-bold;
                    }
                    h3 {
                        @apply font-nunito font-bold;
                    }
                    h4 {
                        @apply font-nunito font-semibold;
                    }
                    body {
                        @apply font-opensans bg-gray-50;
                    }
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Menu mobile
                    const mobileMenuButton = document.getElementById('mobile-menu-button');
                    const mobileMenu = document.getElementById('mobile-menu');
                    
                    if (mobileMenuButton && mobileMenu) {
                        mobileMenuButton.addEventListener('click', function() {
                            mobileMenu.classList.toggle('hidden');
                        });
                    }

                    // Menu utilisateur
                    const userMenuButton = document.getElementById('user-menu-button');
                    const userDropdown = document.getElementById('user-dropdown');
                    
                    if (userMenuButton && userDropdown) {
                        userMenuButton.addEventListener('click', function() {
                            userDropdown.classList.toggle('hidden');
                        });

                        // Fermer le menu quand on clique ailleurs
                        document.addEventListener('click', function(e) {
                            if (!userMenuButton.contains(e.target) && !userDropdown.contains(e.target)) {
                                userDropdown.classList.add('hidden');
                            }
                        });
                    }
                });
            </script>
        {% endblock %}
    </head>
    <body class="bg-[url(/uploads/images/Fond.svg)] bg-cover bg-repeat-y flex flex-col min-h-screen">
        <!-- Navbar -->
        {{ render(controller('App\\Controller\\SearchController::navbar')) }}

        <!-- Messages flash -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mx-auto max-w-7xl px-4 mt-4 {% if label == 'success' %}bg-green-100 text-green-800{% elseif label == 'error' %}bg-red-100 text-red-800{% else %}bg-blue-100 text-blue-800{% endif %} p-4 rounded-md">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Contenu principal -->
        <main class="flex-grow">
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="text-white mt-10">
            <!-- Bloc haut -->
            <div class="bg-primary px-6 py-8">
                <div class="space-y-4 text-sm">

                <a href="{{ path('app_home') }}" class="py-1 font-semibold">Accueil</a>
                <!-- Découvrir -->
                <div>
                    <button class="w-full flex items-center justify-between font-semibold dropdown-toggle">
                    <span>Découvrir</span>
                    <span class="transition-transform">&#x25BC;</span>
                    </button>
                    <div class="dropdown-menu flex flex-col hidden ml-2 mt-2 text-white/90">
                        <a href="{{ path('app_product_index') }}" class="py-1">Les produits</a>
                        <a href="{{ path('app_creator_index') }}" class="py-1">Les créateurs</a>
                        <a href="{{ path('app_event_index') }}" class="py-1">Les événements</a>
                        <a href="{{ path('app_post_index') }}" class="py-1">Les posts</a>
                    </div>
                </div>

                <!-- Vendre -->
                <div>
                    <button class="w-full flex items-center justify-between font-semibold dropdown-toggle">
                    <span>Vendre</span>
                    <span class="transition-transform">&#x25BC;</span>
                    </button>
                    <div class="dropdown-menu flex flex-col hidden ml-2 mt-2 text-white/90">
                        <a href="{{ path('app_register_creator') }}" class="py-1">Devenir créateur</a>
                        <a href="#" class="py-1">Tarifs</a>
                    </div>
                </div>

                <!-- À propos -->
                <div>
                    <button class="w-full flex items-center justify-between font-semibold dropdown-toggle">
                    <span>A propos</span>
                    <span class="transition-transform">&#x25BC;</span>
                    </button>
                    <div class="dropdown-menu hidden ml-2 mt-2 text-white/90">
                    <p class="py-1">Notre mission</p>
                    <p class="py-1">L'équipe</p>
                    </div>
                </div>

                <!-- Aide -->
                <div>
                    <button class="w-full flex items-center justify-between font-semibold dropdown-toggle">
                    <span>Aide</span>
                    <span class="transition-transform rotate-180">&#x25BC;</span>
                    </button>
                    <div class="dropdown-menu ml-2 mt-2 text-white/90">
                    <p class="py-1">Centre d’aide</p>
                    <p class="py-1">Paramètre de confidentialité</p>
                    </div>
                </div>

                </div>
            </div>

            <!-- Bloc bas -->
            <div class="bg-[#242424] px-6 py-6 text-sm space-y-4">
                <div class="flex flex-col md:flex-row md:space-x-6 space-y-2 md:space-y-0">
                    <a href="#" class="hover:underline">Condition d'utilisation</a>
                    <a href="#" class="hover:underline">Confidentialité</a>
                    <a href="#" class="hover:underline">Cookies</a>
                </div>
            </div>
            <div class="bg-white text-sm space-y-4 text-center py-2">
                <span class="text-sm font-semibold text-[#242424]">&copy; {{ "now"|date('Y') }} Awen. Tous droits réservés.</span>
            </div>
        </footer>

        <script>
        document.querySelectorAll('.dropdown-toggle').forEach((btn) => {
            btn.addEventListener('click', () => {
            const menu = btn.nextElementSibling;
            const icon = btn.querySelector('span:last-child');
            menu.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
            });
        });
        </script>


