<nav class="bg-white shadow" x-data="{ open: false, userMenuOpen: false }" @click.away="open = false; userMenuOpen = false">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex justify-between items-center">
            <!-- Logo -->
            <div class="flex-shrink-0">
                <a href="{{ path('app_home') }}">
                    <img src="{{ asset('uploads/images/awen-logo.png') }}" alt="Awen Logo" class="h-10">
                </a>
            </div>

            <!-- Desktop navigation -->
            <div class="hidden md:flex space-x-8">
                <a href="{{ path('app_product_index') }}" class="text-gray-500 hover:text-gray-900">Produits</a>
                <a href="{{ path('app_creator_index') }}" class="text-gray-500 hover:text-gray-900">Créateurs</a>
                <a href="{{ path('app_event_index') }}" class="text-gray-500 hover:text-gray-900">Événements</a>
            </div>

            <!-- Right actions -->
            <div class="flex items-center space-x-4">
                <!-- Search bar (desktop only) -->
                <div class="hidden md:block w-64">
                    {{ form_start(desktopForm, {'attr': {'class': 'relative', 'action': path('app_search'), 'method': 'get'}}) }}
                        {{ form_widget(desktopForm.query, {
                            'attr': {
                                'class': 'w-full rounded-full border border-gray-300 pl-4 pr-10 py-2 focus:outline-none focus:ring-2 focus:ring-primary',
                                'placeholder': 'Recherche'
                            }
                        }) }}
                        <button type="submit" class="absolute right-1 top-1 bottom-1 bg-black text-white rounded-full px-3 flex items-center justify-center">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </button>
                    {{ form_end(desktopForm) }}
                </div>

                <!-- Panier -->
                <a href="{{ path('app_cart_index') }}" class="text-gray-500 hover:text-gray-900">
                    <div class="relative">
                        <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                        {% if app.session.get('cart')|length > 0 %}
                            <span class="absolute -top-2 -right-2 bg-primary text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">
                                {{ app.session.get('cart')|length }}
                            </span>
                        {% endif %}
                    </div>
                </a>

                <!-- User -->
                {% if app.user %}
                    <div class="relative hidden md:block" x-data="{ userMenuOpen: false }">                        <button @click="userMenuOpen = !userMenuOpen" class="focus:outline-none">
                            {% if app.user.profilePicture %}
                                <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilePicture) }}"
                                     alt="{{ app.user.username }}"
                                     class="h-10 w-10 rounded-full object-cover border-2 border-primary hover:border-primary/80 transition-colors">
                            {% else %}
                                <svg class="h-8 w-8 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 12a5 5 0 100-10 5 5 0 000 10zm0 2c-3 0-9 1.5-9 4.5V20h18v-1.5c0-3-6-4.5-9-4.5z"/>
                                </svg>
                            {% endif %}
                        </button>

                        <!-- Dropdown user menu -->
                        <div x-show="userMenuOpen"
                             @click.away="userMenuOpen = false"
                             class="absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 py-1 z-50">
                            {% if is_granted('ROLE_CREATOR') %}
                                <a href="{{ path('app_creator_dashboard') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Espace créateur</a>
                            {% endif %}
                            <a href="{{ path('app_profile_show', {'username': app.user.username}) }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Mon profil</a>
                            <a href="{{ path('app_account_settings') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Mon compte</a>
                            <a href="{{ path('app_account_orders') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Mes commandes</a>
                            <div class="border-t border-gray-100"></div>
                            <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Déconnexion</a>
                        </div>
                    </div>
                {% else %}
                    <div class="hidden md:flex space-x-4">
                        <a href="{{ path('app_login') }}" class="text-gray-500 hover:text-gray-900">Connexion</a>
                        <a href="{{ path('app_register') }}" class="text-gray-500 hover:text-gray-900">Inscription</a>
                    </div>
                {% endif %}                <!-- Mobile user icon and burger menu -->
                <div class="md:hidden flex items-center space-x-3">
                    <!-- User icon -->
                    <button @click="userMenuOpen = !userMenuOpen" class="focus:outline-none">
                        {% if app.user and app.user.profilePicture %}
                            <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilePicture) }}"
                                 alt="{{ app.user.username }}"
                                 class="h-10 w-10 rounded-full object-cover border-2 border-primary hover:border-primary/80 transition-colors">
                        {% else %}
                            <svg class="h-8 w-8 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 12a5 5 0 100-10 5 5 0 000 10zm0 2c-3 0-9 1.5-9 4.5V20h18v-1.5c0-3-6-4.5-9-4.5z"/>
                            </svg>
                        {% endif %}
                    </button>                    <!-- Burger menu button -->
                    <button @click="open = !open" class="focus:outline-none p-2">
                        <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                  :d="open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16'"/>
                        </svg>
                    </button>
                </div>
            </div>        </div>        <!-- Mobile burger menu -->
        <div x-show="open" class="md:hidden border-t border-gray-200 mt-4 pt-4">
            <div class="space-y-2 px-4 pb-4">
                <a href="{{ path('app_product_index') }}" 
                   class="block text-gray-700 hover:text-primary font-medium py-2"
                   @click="open = false">
                    Produits
                </a>
                <a href="{{ path('app_creator_index') }}" 
                   class="block text-gray-700 hover:text-primary font-medium py-2"
                   @click="open = false">
                    Créateurs
                </a>
                <a href="{{ path('app_event_index') }}" 
                   class="block text-gray-700 hover:text-primary font-medium py-2"
                   @click="open = false">
                    Événements
                </a>
            </div>
        </div>        <!-- Mobile user menu -->
        <div x-show="userMenuOpen" class="md:hidden border-t border-gray-200 mt-4 pt-4">
            <div class="space-y-2 px-4 pb-4">
                {% if app.user %}
                    {% if is_granted('ROLE_CREATOR') %}
                        <a href="{{ path('app_creator_dashboard') }}" 
                           class="block text-gray-700 hover:text-primary font-medium py-2"
                           @click="userMenuOpen = false">
                            Espace créateur
                        </a>
                    {% endif %}
                    <a href="{{ path('app_profile_show', {'username': app.user.username}) }}" 
                       class="block text-gray-700 hover:text-primary font-medium py-2"
                       @click="userMenuOpen = false">
                        Mon profil
                    </a>
                    <a href="{{ path('app_account_settings') }}" 
                       class="block text-gray-700 hover:text-primary font-medium py-2"
                       @click="userMenuOpen = false">
                        Mon compte
                    </a>
                    <a href="{{ path('app_account_orders') }}" 
                       class="block text-gray-700 hover:text-primary font-medium py-2"
                       @click="userMenuOpen = false">
                        Mes commandes
                    </a>
                    <div class="border-t border-gray-100 my-2"></div>
                    <a href="{{ path('app_logout') }}" 
                       class="block text-red-600 hover:text-red-700 font-medium py-2"
                       @click="userMenuOpen = false">
                        Déconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" 
                       class="block text-gray-700 hover:text-primary font-medium py-2"
                       @click="userMenuOpen = false">
                        Connexion
                    </a>
                    <a href="{{ path('app_register') }}" 
                       class="block text-gray-700 hover:text-primary font-medium py-2"
                       @click="userMenuOpen = false">
                        Inscription
                    </a>
                {% endif %}
            </div>
        </div><!-- Mobile search bar under all nav content -->
        <div class="block md:hidden px-4 pt-4 pb-2">
            {{ form_start(mobileForm, {'attr': {'class': 'relative', 'action': path('app_search'), 'method': 'get'}}) }}
                {{ form_widget(mobileForm.query, {
                    'attr': {
                        'class': 'w-full rounded-full border border-gray-300 pl-4 pr-10 py-2 focus:outline-none focus:ring-2 focus:ring-primary',
                        'placeholder': 'Recherche'
                    }
                }) }}
                <button type="submit" class="absolute right-1 top-1 bottom-1 bg-black text-white rounded-full px-3 flex items-center justify-center">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </button>
            {{ form_end(mobileForm) }}
        </div>

    </div>
</nav>
