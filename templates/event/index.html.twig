{% extends 'base.html.twig' %}

{% block title %}Événements - Awen{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Événements</h1>
        {% if is_granted('ROLE_CREATOR') %}
            <a href="{{ path('app_event_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Créer un événement
            </a>
        {% endif %}
    </div>

    {# Filtres #}
    <div class="bg-white rounded-lg shadow mb-6 p-4">
        <form method="get" class="space-y-4">
            {# Catégories #}
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Catégories</label>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('app_event_index', {'sort': current_sort, 'period': current_period}) }}" 
                       class="inline-flex items-center px-3 py-1 rounded-full text-sm {{ not current_category ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200' }}">
                        Toutes
                    </a>
                    {% for category in categories %}
                        <a href="{{ path('app_event_index', {'category': category.id, 'sort': current_sort, 'period': current_period}) }}" 
                           class="inline-flex items-center px-3 py-1 rounded-full text-sm {{ current_category and current_category.id == category.id ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200' }}">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Période #}
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Période</label>
                <div class="flex flex-wrap gap-2">
                    {% for value, label in period_options %}
                        <a href="{{ path('app_event_index', {
                            'category': current_category ? current_category.id : null,
                            'sort': current_sort,
                            'period': value
                        }) }}" 
                           class="inline-flex items-center px-3 py-1 rounded-full text-sm {{ current_period == value ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200' }}">
                            {{ label }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Tri #}
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Trier par</label>
                <div class="flex flex-wrap gap-2">
                    {% for value, label in sort_options %}
                        <a href="{{ path('app_event_index', {
                            'category': current_category ? current_category.id : null,
                            'period': current_period,
                            'sort': value
                        }) }}" 
                           class="inline-flex items-center px-3 py-1 rounded-full text-sm {{ current_sort == value ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200' }}">
                            {{ label }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </form>
    </div>

    <div class="space-y-6">
        {% for event in events %}
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow {% if event.status.value == 'cancelled' %}border-2 border-red-500{% endif %}">
                <div class="md:flex">
                    <!-- Image de l'événement -->
                    <div class="md:flex-shrink-0 relative">
                        {% if event.images|length > 0 %}
                            <img class="h-48 w-full md:w-48 object-cover {% if event.status.value == 'cancelled' %}opacity-50{% endif %}" 
                                 src="{{ asset('uploads/images/' ~ event.images[0].filename) }}" 
                                 alt="{{ event.images[0].alt }}">
                        {% else %}
                            <div class="h-48 w-full md:w-48 bg-gray-100 flex items-center justify-center">
                                <svg class="h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        {% endif %}
                        
                        {% if event.status.value == 'cancelled' %}
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="bg-red-600 text-white px-3 py-1 rounded-full text-sm font-medium transform rotate-12">
                                    ANNULÉ
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Contenu de l'événement -->
                    <div class="p-6 flex-1">
                        <div class="flex justify-between items-start">
                            <div>
                                <h2 class="text-xl font-semibold text-gray-900 mb-2">{{ event.title }}</h2>
                                <p class="text-gray-600 mb-4">{{ event.shortDescription }}</p>
                            </div>
                        </div>

                        <!-- Informations de l'événement -->
                        <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-4">
                            <div class="flex items-center">
                                <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                {{ event.startDateTime|date('d/m/Y H:i') }}
                            </div>
                            
                            {% if event.location %}
                                <div class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                    {{ event.location }}
                                </div>
                            {% endif %}
                        </div>

                        <!-- Catégories -->
                        <div class="mb-4">
                            {{ include('components/_category_badges.html.twig', {
                                categories: event.eventCategories,
                                type: 'event'
                            }) }}
                        </div>

                        <!-- Actions -->
                        <div class="mt-4">
                            <a href="{{ path('app_event_show', {'id': event.id}) }}" 
                               class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                                Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center py-12">
                <p class="text-gray-500">Aucun événement n'est prévu pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}