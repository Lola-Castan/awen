{% extends 'base.html.twig' %}

{% block title %}Produits - Awen{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Produits</h1>
    </div>

    {{ include('components/_filters.html.twig', {
        categories: categories,
        current_category: current_category,
        sort_options: sort_options,
        current_sort: current_sort,
        current_path: 'app_product_index'
    }) }}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for product in products %}            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                {% if product.mainImage %}
                    <div class="h-64 w-full overflow-hidden">
                        <img src="{{ asset('uploads/images/' ~ product.mainImage.filename) }}" 
                             alt="{{ product.name }}"
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                    </div>
                {% else %}
                    <div class="h-64 w-full bg-gray-200 flex items-center justify-center">
                        <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                {% endif %}
                
                <div class="p-4">
                    <h2 class="text-xl font-semibold text-gray-800 mb-2">{{ product.name }}</h2>
                    
                    {{ include('components/_category_badges.html.twig', {
                        categories: product.categories,
                        type: 'product'
                    }) }}
                    
                    <p class="text-gray-600 mt-2">{{ product.shortDescription }}</p>
                    
                    <div class="mt-4 flex justify-between items-center">
                        <span class="text-2xl font-bold text-primary">{{ (product.price / 100)|format_currency('EUR') }}</span>
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" 
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary/90">
                            Voir le produit
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-gray-500">Aucun produit trouvé.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
