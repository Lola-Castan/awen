{% extends 'base.html.twig' %}

{% block title %}Recherche{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Barre de recherche principale -->
    <div class="mb-8">
        {{ form_start(form, {'attr': {'class': 'max-w-2xl mx-auto'}}) }}
            <div class="flex gap-2">
                {{ form_widget(form.query, {
                    'attr': {
                        'class': 'flex-1 rounded-lg border-gray-300 shadow-sm focus:border-primary focus:ring-primary',
                        'placeholder': 'Rechercher des créateurs, produits, événements...'
                    }
                }) }}
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    Rechercher
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    {% if form.vars.submitted %}
        {% set total = results.creators|length + results.products|length + results.events|length + results.posts|length %}
        
        <!-- En-tête des résultats -->
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-900">
                {% if total > 0 %}
                    {{ total }} résultat{% if total > 1 %}s{% endif %} trouvé{% if total > 1 %}s{% endif %}
                {% else %}
                    Aucun résultat
                {% endif %}
            </h2>
        </div>

        <!-- Section Créateurs -->
        {% if results.creators|length > 0 %}
            <div class="mb-12">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    Créateurs ({{ results.creators|length }})
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for creator in results.creators %}
                        <a href="{{ path('creator_show', {'id': creator.id}) }}" class="block group">
                            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-4 flex items-center space-x-4">
                                {% if creator.profilePicture %}
                                    <img src="{{ asset('uploads/profile/' ~ creator.profilePicture) }}" alt="{{ creator.username }}" class="w-16 h-16 rounded-full object-cover">
                                {% else %}
                                    <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center">
                                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                    </div>
                                {% endif %}
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate group-hover:text-primary">
                                        {{ creator.creatorInfo.displayName ?? creator.username }}
                                    </p>
                                    {% if creator.creatorInfo.description %}
                                        <p class="text-sm text-gray-500 truncate">
                                            {{ creator.creatorInfo.description }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Section Produits -->
        {% if results.products|length > 0 %}
            <div class="mb-12">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    Produits ({{ results.products|length }})
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for product in results.products %}
                        <a href="{{ path('product_show', {'id': product.id}) }}" class="group">
                            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                                {% if product.mainImage %}
                                    <div class="aspect-w-16 aspect-h-9">
                                        <img src="{{ asset('uploads/images/' ~ product.mainImage.filename) }}" 
                                             alt="{{ product.name }}" 
                                             class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300">
                                    </div>
                                {% endif %}
                                <div class="p-4">
                                    <h4 class="text-sm font-medium text-gray-900 group-hover:text-primary truncate">{{ product.name }}</h4>
                                    <p class="mt-1 text-sm text-gray-500 line-clamp-2">{{ product.shortDescription }}</p>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Section Événements -->
        {% if results.events|length > 0 %}
            <div class="mb-12">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    Événements ({{ results.events|length }})
                </h3>
                <div class="space-y-4">
                    {% for event in results.events %}
                        <a href="{{ path('app_event_show', {'id': event.id}) }}" class="block group">
                            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-4">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1 min-w-0">
                                        <h4 class="text-sm font-medium text-gray-900 group-hover:text-primary">{{ event.title }}</h4>
                                        <p class="mt-1 text-sm text-gray-500 line-clamp-2">{{ event.shortDescription }}</p>
                                        <div class="mt-2 flex items-center text-sm text-gray-500 space-x-4">
                                            <span class="flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                {{ event.startDateTime|date('d/m/Y H:i') }}
                                            </span>
                                            {% if event.location %}
                                                <span class="flex items-center">
                                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    </svg>
                                                    {{ event.location }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% if event.status == constant('App\\Enum\\EventStatus::Cancelled') %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            Annulé
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Section Posts -->
        {% if results.posts|length > 0 %}
            <div class="mb-12">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                    Articles ({{ results.posts|length }})
                </h3>
                <div class="space-y-4">
                    {% for post in results.posts %}
                        <a href="{{ path('post_show', {'id': post.id}) }}" class="block group">
                            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                                <div class="md:flex">
                                    {% if post.mainImage %}
                                        <div class="md:flex-shrink-0">
                                            <img src="{{ asset('uploads/images/' ~ post.mainImage.filename) }}" 
                                                 alt="" 
                                                 class="h-48 w-full md:w-48 object-cover">
                                        </div>
                                    {% endif %}
                                    <div class="p-4">
                                        <h4 class="text-sm font-medium text-gray-900 group-hover:text-primary">{{ post.title }}</h4>
                                        <p class="mt-1 text-sm text-gray-500 line-clamp-2">{{ post.content|striptags }}</p>
                                        <div class="mt-2 flex items-center text-sm text-gray-500">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                            {{ post.author.username }}
                                            <span class="mx-2">&middot;</span>
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                            {{ post.createdAt|date('d/m/Y') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Message si aucun résultat -->
        {% if total == 0 %}
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun résultat</h3>
                <p class="mt-1 text-sm text-gray-500">Nous n'avons trouvé aucun résultat correspondant à votre recherche.</p>
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %} 