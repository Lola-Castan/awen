{% extends 'base.html.twig' %}

{% block title %}Espace Créateur{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
	<header class="mb-8">
		<h1 class="text-3xl font-bold text-gray-900">Espace Créateur</h1>
		<p class="mt-2 text-lg text-gray-600">Bienvenue dans votre espace de gestion de créateur</p>
	</header>
	
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		<!-- Carte pour les produits -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
			<div class="p-6">
				<div class="flex items-center justify-center w-12 h-12 rounded-md bg-indigo-500 text-white mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
					</svg>
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">Mes Produits</h2>
				<p class="text-gray-600 mb-4">Gérez vos produits, ajoutez-en de nouveaux ou modifiez les existants.</p>
				<div class="flex space-x-2">
					<a href="{{ path('app_creator_products') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
						Accéder
					</a>
					<a href="{{ path('app_creator_product_new') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-indigo-600 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
						<svg xmlns="http://www.w3.org/2000/svg" class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
						</svg>
						Ajouter
					</a>
				</div>
			</div>
		</div>

		<!-- Carte pour les commandes -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
			<div class="p-6">
				<div class="flex items-center justify-center w-12 h-12 rounded-md bg-indigo-500 text-white mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
					</svg>
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">Mes Commandes</h2>
				<p class="text-gray-600 mb-4">Gérez vos commandes, consultez les détails et les statuts.</p>
				<div class="flex space-x-2">
					<a href="{{ path('app_creator_dashboard_orders') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
						Accéder
					</a>
				</div>
			</div>
		</div>
		
		<!-- Carte pour les événements -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
			<div class="p-6">
				<div class="flex items-center justify-center w-12 h-12 rounded-md bg-indigo-500 text-white mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">Mes Événements</h2>
				<p class="text-gray-600 mb-4">Gérez vos événements, créez-en de nouveaux ou modifiez les existants.</p>
				<a href="{{ path('app_creator_show', {'id': app.user.id, 'tab': 'events'}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
					Accéder
				</a>
			</div>
		</div>
		
		<!-- Carte pour les posts du blog -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
			<div class="p-6">
				<div class="flex items-center justify-center w-12 h-12 rounded-md bg-indigo-500 text-white mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
					</svg>
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">Mes Posts</h2>
				<p class="text-gray-600 mb-4">Gérez vos posts, partagez votre savoir-faire et votre actualité.</p>
				<a href="{{ path('app_post_by_author', {'id': app.user.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
					Accéder
				</a>
			</div>
		</div>

		<!-- Carte pour le profil -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
			<div class="p-6">
				<div class="flex items-center justify-center w-12 h-12 rounded-md bg-indigo-500 text-white mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
					</svg>
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">Mon Profil Créateur</h2>
				<p class="text-gray-600 mb-4">Modifiez les informations de votre profil créateur, votre description et vos réseaux sociaux.</p>
				<a href="{{ path('app_creator_edit', {'id': app.user.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
					Modifier
				</a>
			</div>
		</div>
		
		<!-- Carte pour les statistiques -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
			<div class="p-6">
				<div class="flex items-center justify-center w-12 h-12 rounded-md bg-indigo-500 text-white mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
					</svg>
				</div>
				<h2 class="text-xl font-semibold text-gray-800 mb-2">Statistiques</h2>
				<p class="text-gray-600 mb-4">Consultez les statistiques de vos produits, événements et publications.</p>
				<button disabled class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-gray-400 cursor-not-allowed">
					Bientôt disponible
				</button>
			</div>
		</div>
	</div>
</div>
{% endblock %}
