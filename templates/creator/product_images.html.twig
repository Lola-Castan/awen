{% extends 'base.html.twig' %}

{% block title %}Gérer les images | Espace Créateur{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Gérer les images du produit</h1>
        <div class="mt-2 flex items-center">
            <a href="{{ path('app_creator_product_edit', {'id': product.id}) }}" class="text-sm text-indigo-600 hover:text-indigo-900 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Retour à l'édition du produit
            </a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-6 p-4 rounded-md 
                {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200
                {% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200
                {% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-8">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg leading-6 font-medium text-gray-900">
                Images du produit <span class="text-gray-500 font-normal">{{ product.name }}</span>
            </h3>
            <p class="mt-1 max-w-2xl text-sm text-gray-500">
                Ajoutez des images à votre produit pour mieux le mettre en valeur. L'image avec la position 0 sera utilisée comme image principale.
            </p>
        </div>
        
        <div class="px-4 py-5 sm:p-6">
            {% if product.images.empty %}
                <div class="text-center py-8">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Aucune image</h3>
                    <p class="mt-1 text-sm text-gray-500">Commencez par ajouter des images à votre produit</p>
                </div>
            {% else %}
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    {% for image in product.images %}
                        <div class="relative rounded-lg overflow-hidden shadow-sm border border-gray-200 group">
                            <div class="relative pb-3/4">
                                <img src="{{ asset('uploads/images/' ~ image.filename) }}" 
									alt="{{ image.alt|default(product.name) }}" 
									class="h-full w-full object-cover">
                            </div>
                            <div class="p-3 bg-white">
                                <p class="text-sm font-medium text-gray-900 truncate">
                                    {% if image.title %}{{ image.title }}{% else %}Image {{ loop.index }}{% endif %}
                                </p>
                                <p class="text-xs text-gray-500 mt-1">
                                    Position: {{ image.position }} 
                                    {% if image.position == 0 %}
                                        <span class="ml-1 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Principale
                                        </span>
                                    {% endif %}
                                </p>
                                <div class="mt-2 flex items-center justify-between">
                                    <form action="{{ path('app_creator_product_image_position', {'id': product.id, 'imageId': image.id}) }}" method="POST" class="flex items-center space-x-2">
                                        <input type="number" name="position" value="{{ image.position }}" min="0" 
                                            class="w-16 py-1 px-2 text-xs border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
                                        <button type="submit" class="text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded-md hover:bg-indigo-200">
                                            Modifier
                                        </button>
                                    </form>
                                    <a href="{{ path('app_creator_product_image_remove', {'id': product.id, 'imageId': image.id}) }}" 
                                       class="text-red-600 hover:text-red-900 text-xs"
                                       onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette image ?')">
                                        Supprimer
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Ajouter une nouvelle image</h3>
        </div>
        <div class="px-4 py-5 sm:p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <div class="mb-4">
                            {{ form_label(form.file, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(form.file, {'attr': {'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100'}}) }}
                            {{ form_errors(form.file, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                            <p class="mt-1 text-xs text-gray-500">JPG ou PNG. Taille maximale 5MB.</p>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.position, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(form.position, {'attr': {'class': 'mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'}}) }}
                            {{ form_errors(form.position, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                            <p class="mt-1 text-xs text-gray-500">L'image avec la position 0 sera utilisée comme image principale du produit.</p>
                        </div>
                    </div>

                    <div>
                        <div class="mb-4">
                            {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(form.title, {'attr': {'class': 'mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'}}) }}
                            {{ form_errors(form.title, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                            <p class="mt-1 text-xs text-gray-500">Le titre sera affiché sous l'image (facultatif).</p>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.alt, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(form.alt, {'attr': {'class': 'mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'}}) }}
                            {{ form_errors(form.alt, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                            <p class="mt-1 text-xs text-gray-500">Le texte alternatif est utilisé pour l'accessibilité et le référencement (facultatif).</p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-4">
                    <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="-ml-1 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        Ajouter l'image
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Script pour prévisualiser l'image si nécessaire
    document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.querySelector('input[type="file"]');
        fileInput.addEventListener('change', function() {
            // Ici on pourrait ajouter un code pour prévisualiser l'image
        });
    });
</script>
{% endblock %}
