                                            <a href="{{ path('app_creator_product_edit', {'id': product.id}) }}" class="text-gray-600 hover:text-gray-900">Modifier</a>
                                            <a href="{{ path('app_creator_product_images', {'id': product.id}) }}" class="text-gray-600 hover:text-gray-900">Images</a>
                                            <a href="{{ path('app_creator_product_status', {'id': product.id, 'status': 'draft'}) }}" class="text-yellow-600 hover:text-yellow-900">Dépublier</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="bg-white shadow overflow-hidden sm:rounded-lg p-6 text-center">
                    <p class="text-gray-500">Vous n'avez aucun produit publié actuellement.</p>
                </div>
            {% endif %}
        </div>

