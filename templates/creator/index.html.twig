{% extends 'base.html.twig' %}

{% block title %}Créateurs - Awen{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Créateurs</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for creator in creators %}
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <div class="relative h-48">
                    {% if creator.creatorInfo.coverImage %}
                        <img src="{{ asset('uploads/images/' ~ creator.creatorInfo.coverImage) }}" 
                             alt="{{ creator.creatorInfo.displayName }}"
                             class="w-full h-full object-cover">
                    {% else %}
                        <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                    {% endif %}
                    
                    <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/60 to-transparent">
                        <div class="flex items-center">
                            {% if creator.profilePicture %}
                                <img src="{{ asset('uploads/profile/' ~ creator.profilePicture) }}" 
                                     alt="{{ creator.username }}"
                                     class="w-12 h-12 rounded-full border-2 border-white mr-3 object-cover">
                            {% else %}
                                <div class="w-12 h-12 rounded-full border-2 border-white mr-3 bg-gray-200 flex items-center justify-center">
                                    <span class="text-gray-600 font-medium">{{ creator.username|first|upper }}</span>
                                </div>
                            {% endif %}
                            <h2 class="text-lg font-semibold text-white">
                                {{ creator.creatorInfo.displayName ?? creator.username }}
                            </h2>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    {% if creator.creatorInfo.description %}
                        <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                            {{ creator.creatorInfo.description }}
                        </p>
                    {% endif %}

                    <div class="mb-4">
                        {{ include('components/_category_badges.html.twig', {
                            categories: creator.categories,
                            type: 'creator'
                        }) }}
                    </div>

                    <div class="flex flex-wrap gap-2 mb-4">
                        {% if creator.creatorInfo.website %}
                            <a href="{{ creator.creatorInfo.website }}" target="_blank" 
                               class="text-gray-600 hover:text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                                </svg>
                            </a>
                        {% endif %}
                        
                        {% if creator.creatorInfo.instagramProfile %}
                            <a href="{{ creator.creatorInfo.instagramProfile }}" target="_blank" 
                               class="text-gray-600 hover:text-pink-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </a>
                        {% endif %}
                        
                        {% if creator.creatorInfo.facebookProfile %}
                            <a href="{{ creator.creatorInfo.facebookProfile }}" target="_blank" 
                               class="text-gray-600 hover:text-blue-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
                                </svg>
                            </a>
                        {% endif %}
                    </div>

                    <a href="{{ path('creator_show', {'id': creator.id}) }}" 
                       class="block w-full text-center bg-primary text-white py-2 rounded hover:bg-opacity-90 transition-colors">
                        Voir le profil
                    </a>
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-gray-500">Aucun créateur n'est inscrit pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}