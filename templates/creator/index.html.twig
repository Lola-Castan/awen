{% extends 'base.html.twig' %}

{% block title %}Créateurs - Awen{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Créateurs</h1>
    </div>

    {{ include('components/_filters.html.twig', {
        categories: categories,
        current_category: current_category,
        sort_options: sort_options,
        current_sort: current_sort,
        current_path: 'creators'
    }) }}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for creator in creators %}
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <div class="relative h-48">
                    {% if creator.creatorInfo.coverImage %}
                        <img src="{{ asset('uploads/images/' ~ creator.creatorInfo.coverImage) }}" 
                             alt="{{ creator.creatorInfo.displayName }}"
                             class="object-cover w-full h-full">
                    {% endif %}
                </div>
                
                <div class="p-4">
                    <h2 class="text-xl font-semibold text-gray-800 mb-2">{{ creator.creatorInfo.displayName }}</h2>
                    
                    {{ include('components/_category_badges.html.twig', {
                        categories: creator.categories,
                        type: 'creator'
                    }) }}
                    
                    {% if creator.creatorInfo.description %}
                        <p class="text-gray-600 mt-2">{{ creator.creatorInfo.description|u.truncate(100, '...') }}</p>
                    {% endif %}
                    
                    <div class="mt-4 flex justify-between items-center">
                        <div class="text-sm text-gray-500">
                            {{ creator.products|length }} produits
                        </div>
                        <a href="{{ path('creator_show', {'id': creator.id}) }}" 
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary/90">
                            Voir le profil
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-gray-500">Aucun créateur trouvé.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}